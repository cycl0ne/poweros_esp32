+/* The window's pointer, scaled to the window's pixels. A window sends it
+ * absolute; the monitor's mouse_move sends it relative, which is added up
+ * and kept inside the window, so a script can drive it too. */
+static void esp_rgb_pointer_event(DeviceState *dev, QemuConsole *src,
+                                  InputEvent *evt)
+{
+    ESPRgbState *s = ESP_RGB(dev);
+    InputMoveEvent *move;
+    InputBtnEvent *btn;
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS:
+        move = evt->u.abs.data;
+        if (move->axis == INPUT_AXIS_X) {
+            s->pointer_x = qemu_input_scale_axis(move->value, INPUT_EVENT_ABS_MIN,
+                                                 INPUT_EVENT_ABS_MAX, 0, s->width - 1);
+        } else if (move->axis == INPUT_AXIS_Y) {
+            s->pointer_y = qemu_input_scale_axis(move->value, INPUT_EVENT_ABS_MIN,
+                                                 INPUT_EVENT_ABS_MAX, 0, s->height - 1);
+        }
+        break;
+    case INPUT_EVENT_KIND_REL: {
+        int64_t at;
+        move = evt->u.rel.data;
+        if (move->axis == INPUT_AXIS_X) {
+            at = (int64_t)s->pointer_x + move->value;
+            s->pointer_x = at < 0 ? 0 : (at >= s->width ? s->width - 1 : at);
+        } else if (move->axis == INPUT_AXIS_Y) {
+            at = (int64_t)s->pointer_y + move->value;
+            s->pointer_y = at < 0 ? 0 : (at >= s->height ? s->height - 1 : at);
+        }
+        break;
+    }
+    case INPUT_EVENT_KIND_BTN:
+        btn = evt->u.btn.data;
+        if (btn->button == INPUT_BUTTON_LEFT) {
+            s->pointer_down = btn->down;
+        } else if (btn->button == INPUT_BUTTON_RIGHT) {
+            s->pointer_right = btn->down;
+        } else if (btn->button == INPUT_BUTTON_MIDDLE) {
+            s->pointer_middle = btn->down;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void esp_rgb_pointer_sync(DeviceState *dev)
+{
+    ESPRgbState *s = ESP_RGB(dev);
+    s->pointer_seq++;
+}
+
+static const QemuInputHandler esp_rgb_pointer = {
+    .name  = "ESP RGB mouse",
+    .mask  = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS | INPUT_EVENT_MASK_REL,
+    .event = esp_rgb_pointer_event,
+    .sync  = esp_rgb_pointer_sync,
+};
+
+/* A key in the window, as its Linux keycode, onto the queue. When the queue
+ * is full the oldest goes, so a key's release is never the one lost. */
+static void esp_rgb_key_event(DeviceState *dev, QemuConsole *src,
+                              InputEvent *evt)
+{
+    ESPRgbState *s = ESP_RGB(dev);
+    InputKeyEvent *key;
+    int qcode;
+    uint32_t code, entry;
+
+    if (evt->type != INPUT_EVENT_KIND_KEY) {
+        return;
+    }
+    key = evt->u.key.data;
+    qcode = qemu_input_key_value_to_qcode(key->key);
+    if (qcode < 0 || qcode >= qemu_input_map_qcode_to_linux_len) {
+        return;
+    }
+    code = qemu_input_map_qcode_to_linux[qcode];
+    if (code == 0) {
+        return;
+    }
+    entry = FIELD_DP32(0, RGB_KEY, CODE, code);
+    entry = FIELD_DP32(entry, RGB_KEY, DOWN, key->down);
+    entry = FIELD_DP32(entry, RGB_KEY, VALID, 1);
+    if (s->key_count == ESP_RGB_KEY_FIFO) {
+        s->key_head = (s->key_head + 1) % ESP_RGB_KEY_FIFO;
+        s->key_count--;
+    }
+    s->keys[(s->key_head + s->key_count) % ESP_RGB_KEY_FIFO] = entry;
+    s->key_count++;
+}
+
+static const QemuInputHandler esp_rgb_keyboard = {
+    .name  = "ESP RGB keyboard",
+    .mask  = INPUT_EVENT_MASK_KEY,
+    .event = esp_rgb_key_event,
+};
+
 static void esp_rgb_realize(DeviceState *dev, Error **errp)
 {
     ESPRgbState* s = ESP_RGB(dev);
 
+    s->pointer_handler = qemu_input_handler_register(dev, &esp_rgb_pointer);
+    qemu_input_handler_activate(s->pointer_handler);
+    s->key_handler = qemu_input_handler_register(dev, &esp_rgb_keyboard);
+    qemu_input_handler_activate(s->key_handler);
+
     assert(s->intram != NULL);
     /* Create an address space for internal RAM so that we can read data from it on GUI update */
     address_space_init(&s->intram_as, s->intram, "esp.rgb.intram_as");
