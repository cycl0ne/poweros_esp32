+REG32(RGB_BPP_VALUE, 0x18)
+
+/* The pointer over the window, in its pixels, and its buttons: DOWN the
+ * left, RIGHT and MIDDLE the other two (minor version 5 and up). */
+REG32(RGB_POINTER, 0x1c)
+    FIELD(RGB_POINTER, Y, 0, 14)
+    FIELD(RGB_POINTER, MIDDLE, 14, 1)
+    FIELD(RGB_POINTER, RIGHT, 15, 1)
+    FIELD(RGB_POINTER, X, 16, 15)
+    FIELD(RGB_POINTER, DOWN, 31, 1)
+
+/* How many pointer events there have been: a press and release between
+ * two reads of RGB_POINTER still changes it. */
+REG32(RGB_POINTER_SEQ, 0x20)
+
+/* Reading takes the oldest key event off the queue: bit 31 set when there
+ * was one, bit 30 when it is a key going down, bits 0-15 its Linux
+ * keycode. 0 when none waits. */
+REG32(RGB_KEY, 0x24)
+    FIELD(RGB_KEY, CODE, 0, 16)
+    FIELD(RGB_KEY, DOWN, 30, 1)
+    FIELD(RGB_KEY, VALID, 31, 1)
+
+/* How many key events wait. */
+REG32(RGB_KEY_COUNT, 0x28)
