+/* show-cursor=off with a pointer the guest is told the position of: the
+ * guest draws its own pointer, so the host's stays hidden over the window,
+ * grabbed or not. */
+static bool sdl_guest_draws_cursor(struct sdl2_console *scon)
+{
+    return scon->opts->has_show_cursor && !scon->opts->show_cursor &&
+           (qemu_input_is_absolute(scon->dcl.con) || absolute_enabled);
+}
+
 static void sdl_show_cursor(struct sdl2_console *scon)
 {
     if (scon->opts->has_show_cursor && scon->opts->show_cursor) {
         return;
     }
+    if (sdl_guest_draws_cursor(scon)) {
+        SDL_ShowCursor(SDL_DISABLE);
+        return;
+    }
 
