# LOCALE:Languages/norsk.language - Norwegian: the words locale.library
# writes and reads dates in, and the order letters sort in. A word left
# out is the English one; a word with a blank is in quotes.
#
# The days, then their short names.
DAY_1=Søndag DAY_2=Mandag DAY_3=Tirsdag DAY_4=Onsdag DAY_5=Torsdag
DAY_6=Fredag DAY_7=Lørdag
ABDAY_1=Søn ABDAY_2=Man ABDAY_3=Tir ABDAY_4=Ons ABDAY_5=Tor
ABDAY_6=Fre ABDAY_7=Lør
# The months, then their short names.
MON_1=Januar MON_2=Februar MON_3=Mars MON_4=April MON_5=Mai
MON_6=Juni MON_7=Juli MON_8=August MON_9=September MON_10=Oktober
MON_11=November MON_12=Desember
ABMON_1=Jan ABMON_2=Feb ABMON_3=Mar ABMON_4=Apr ABMON_5=Mai
ABMON_6=Jun ABMON_7=Jul ABMON_8=Aug ABMON_9=Sep ABMON_10=Okt
ABMON_11=Nov ABMON_12=Des
# Yes and no, before and after noon.
YESSTR=Ja NOSTR=Nei AM_STR=AM PM_STR=PM
# The hyphens and the quotes.
SOFTHYPHEN=- HARDHYPHEN=-
# The days near today, and any day after tomorrow.
YESTERDAYSTR="I går" TODAYSTR="I dag" TOMORROWSTR="I morgen"
FUTURESTR=Fremtid
# The order of the letters: Æ, Ø and Å after Z, Ä taken for Æ and Ö for Ø.
AFTER_Z=ÆÄ,ØÖ,Å
