# LOCALE:Languages/svenska.language - Swedish: the words locale.library
# writes and reads dates in, and the order letters sort in. A word left
# out is the English one; a word with a blank is in quotes.
#
# The days, then their short names.
DAY_1=Söndag DAY_2=Måndag DAY_3=Tisdag DAY_4=Onsdag DAY_5=Torsdag
DAY_6=Fredag DAY_7=Lördag
ABDAY_1=Sön ABDAY_2=Mån ABDAY_3=Tis ABDAY_4=Ons ABDAY_5=Tor
ABDAY_6=Fre ABDAY_7=Lör
# The months, then their short names.
MON_1=Januari MON_2=Februari MON_3=Mars MON_4=April MON_5=Maj
MON_6=Juni MON_7=Juli MON_8=Augusti MON_9=September MON_10=Oktober
MON_11=November MON_12=December
ABMON_1=Jan ABMON_2=Feb ABMON_3=Mar ABMON_4=Apr ABMON_5=Maj
ABMON_6=Jun ABMON_7=Jul ABMON_8=Aug ABMON_9=Sep ABMON_10=Okt
ABMON_11=Nov ABMON_12=Dec
# Yes and no, before and after noon.
YESSTR=Ja NOSTR=Nej AM_STR=fm PM_STR=em
# The hyphens and the quotes.
SOFTHYPHEN=- HARDHYPHEN=-
# The days near today, and any day after tomorrow.
YESTERDAYSTR=Igår TODAYSTR=Idag TOMORROWSTR=Imorgon
FUTURESTR=Framtid
# The order of the letters: Å, Ä and Ö after Z, Æ taken for Ä and Ø for Ö.
AFTER_Z=Å,ÄÆ,ÖØ
