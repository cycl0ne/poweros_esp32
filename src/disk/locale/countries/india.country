# LOCALE:Countries/india.country - India: how dates, times, numbers and
# money are written there, which locale.library takes for a locale whose
# settings name this country. A value with a blank is in quotes; a key
# left out is the United States' own.
#
# The country's ISO code, its telephone code, its measures, the first day
# of its week, and the language spoken there unless the settings say
# otherwise.
CODE=IN
TELEPHONE=91
MEASURE=METRIC
FIRSTDAY=SUNDAY
LANGUAGE=hindi
# Dates and times, long and short, as FormatDate writes them.
DATETIME="%A, %e %B %Y %Q:%M:%S %p"
DATE="%A, %e %B %Y"
TIME="%Q:%M:%S %p"
SHORTDATETIME="%d/%m/%Y %Q:%M %p"
SHORTDATE=%d/%m/%Y
SHORTTIME="%Q:%M %p"
# Numbers: the decimal point, the separator between groups of digits and
# their sizes from the right (3, or 3,2 for three then twos; NONE). A
# lakh is 1,00,000.
DECIMAL=.
GROUP=,
FRACGROUP=,
GROUPING=3,2
FRACGROUPING=3
# Money: the same for amounts, the digits after the point, the currency
# and where it and the sign go.
MONDECIMAL=.
MONGROUP=,
MONFRACGROUP=,
MONGROUPING=3,2
MONFRACGROUPING=3
MONFRACDIGITS=2
MONINTFRACDIGITS=2
CURRENCY=₹
SMALLCURRENCY=पै
INTCURRENCY=INR
POSITIVESIGN=""
POSITIVESPACE=NO
POSITIVESIGNAT=BEFORE
POSITIVECURRENCYAT=BEFORE
NEGATIVESIGN=-
NEGATIVESPACE=NO
NEGATIVESIGNAT=BEFORE
NEGATIVECURRENCYAT=BEFORE
