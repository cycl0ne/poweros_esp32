# LOCALE:Countries/portugal.country - Portugal: how dates, times,
# numbers and money are written there, which locale.library takes for a
# locale whose settings name this country. A value with a blank is in
# quotes; a key left out is the United States' own.
#
# The country's ISO code, its telephone code, its measures, the first day
# of its week, and the language spoken there unless the settings say
# otherwise.
CODE=PT
TELEPHONE=351
MEASURE=METRIC
FIRSTDAY=MONDAY
LANGUAGE=portugues
# Dates and times, long and short, as FormatDate writes them.
DATETIME="%A, %e de %B de %Y, %H:%M:%S"
DATE="%A, %e de %B de %Y"
TIME=%H:%M:%S
SHORTDATETIME="%d/%m/%Y %H:%M:%S"
SHORTDATE=%d/%m/%Y
SHORTTIME=%H:%M
# Numbers: the decimal point, the separator between groups of digits and
# their sizes from the right (3, or 3,2 for three then twos; NONE).
DECIMAL=,
GROUP='
FRACGROUP='
GROUPING=3
FRACGROUPING=3
# Money: the same for amounts, the digits after the point, the currency
# and where it and the sign go.
MONDECIMAL=$
MONGROUP=.
MONFRACGROUP=.
MONGROUPING=3
MONFRACGROUPING=3
MONFRACDIGITS=2
MONINTFRACDIGITS=3
CURRENCY=€
SMALLCURRENCY=ct
INTCURRENCY=EUR
POSITIVESIGN=+
POSITIVESPACE=YES
POSITIVESIGNAT=BEFORE
POSITIVECURRENCYAT=BEFORE
NEGATIVESIGN=-
NEGATIVESPACE=YES
NEGATIVESIGNAT=BEFORE
NEGATIVECURRENCYAT=AFTER
