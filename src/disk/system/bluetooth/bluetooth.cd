MSG_KIND_COMPUTER (//)
computer
MSG_KIND_LAPTOP (//)
laptop
MSG_KIND_HANDHELD (//)
handheld
MSG_KIND_PHONE (//)
phone
MSG_KIND_ACCESS_POINT (//)
network access point
MSG_KIND_HEADSET (//)
headset
MSG_KIND_HANDS_FREE (//)
hands-free
MSG_KIND_MICROPHONE (//)
microphone
MSG_KIND_LOUDSPEAKER (//)
loudspeaker
MSG_KIND_HEADPHONES (//)
headphones
MSG_KIND_PORTABLE_AUDIO (//)
portable audio
MSG_KIND_CAR_AUDIO (//)
car audio
MSG_KIND_HIFI (//)
hi-fi
MSG_KIND_DISPLAY (//)
display
MSG_KIND_GAME_CONSOLE (//)
game console
MSG_KIND_AUDIO_VIDEO (//)
audio and video
MSG_KIND_KEYBOARD (//)
keyboard
MSG_KIND_MOUSE (//)
mouse
MSG_KIND_KEYBOARD_MOUSE (//)
keyboard and mouse
MSG_KIND_JOYSTICK (//)
joystick
MSG_KIND_GAMEPAD (//)
gamepad
MSG_KIND_REMOTE (//)
remote control
MSG_KIND_TABLET (//)
tablet
MSG_KIND_PERIPHERAL (//)
input device
MSG_KIND_IMAGING (//)
printer or camera
MSG_KIND_WEARABLE (//)
wearable
MSG_KIND_TOY (//)
toy
MSG_KIND_HEALTH (//)
health device
MSG_KIND_EARBUDS (//)
earbuds
MSG_KIND_WATCH (//)
watch
MSG_KIND_CLOCK (//)
clock
MSG_KIND_TAG (//)
tag
MSG_KIND_KEYRING (//)
keyring
MSG_KIND_MEDIA_PLAYER (//)
media player
MSG_KIND_THERMOMETER (//)
thermometer
MSG_KIND_HEART_RATE (//)
heart rate sensor
MSG_KIND_SENSOR (//)
sensor
MSG_KIND_LIGHT (//)
light
MSG_KIND_AUDIO_SOURCE (//)
audio source
MSG_KIND_HEARING_AID (//)
hearing aid
;
; The window that asks what a pairing needs: the device's name in bold.
MSG_PAIRING_TITLE (//)
Pairing
MSG_ASK_COMPARE (//)
Does %s show this number?
MSG_ASK_CONSENT (//)
%s asks to pair with this machine.
MSG_ASK_PASSKEY (//)
Type the number %s shows:
MSG_ASK_SHOW (//)
Type this number on %s, then its Enter key:
MSG_ASK_PIN (//)
Type the PIN of %s - 0000 for most devices without keys:
MSG_YES (//)
_Yes
MSG_NO (//)
_No
MSG_CANCEL (//)
_Cancel
;
; The requester Forget asks with.
MSG_FORGET_ASK (//)
Forget %s?\nThe key the two share is deleted: to be\nused again, they are paired again.
MSG_FORGET_BUTTONS (//)
Forget|Cancel
;
; Said in the shell it was started from.
MSG_NO_LIBRARY (//)
%s: %s cannot be opened\n
MSG_NO_MEMORY (//)
%s: there is not the memory\n
MSG_NO_WINDOW (//)
%s: no window could be opened\n
