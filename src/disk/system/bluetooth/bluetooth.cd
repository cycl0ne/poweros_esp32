; Bluetooth's strings, in English: the program is built with these, and
; a translation in LOCALE:Catalogs/<language>/System/Bluetooth.catalog
; stands in for them. A text with values is written by RawDoFmt, which
; takes them in order: a translation keeps them so.
#version 1
;
; The window.
MSG_WINDOW_TITLE (1//)
Bluetooth
MSG_CONTROLLER (//)
_Controller
MSG_ON (//)
_On
MSG_NAME (//)
_Name
MSG_VISIBLE (//)
_Visible to others
MSG_DEVICES (//)
Devices
MSG_SEARCH (//)
_Search
MSG_PAIR (//)
_Pair
MSG_CONNECT (//)
Conn_ect
MSG_DISCONNECT (//)
_Disconnect
MSG_FORGET (//)
_Forget...
;
; The list's columns.
MSG_COLUMN_NAME (//)
Name
MSG_COLUMN_KIND (//)
Kind
MSG_COLUMN_SIGNAL (//)
Signal
MSG_COLUMN_STATE (//)
State
MSG_COLUMN_ADDRESS (//)
Address
;
; The chooser: a controller's number, its address, its device and unit.
MSG_CONTROLLER_LABEL (//)
%u: %s - %s unit %u
MSG_NO_CONTROLLER_LABEL (//)
No controller
;
; The line under the chooser: where the controller is.
MSG_NO_CONTROLLER (//)
No Bluetooth controller: one is shown here as soon as its device offers it
MSG_STARTING (//)
The controller is being set up...
MSG_FAILED (//)
The controller failed: %s
MSG_OFF (//)
Off - check On to use the controller
MSG_HIDDEN (//)
On - devices that search do not find this one
MSG_SHOWN (//)
On - devices that search find this one
MSG_SHOWN_FOR (//)
On - devices that search find this one for %u seconds more
MSG_SEARCHING (//)
Searching for devices...
MSG_FOUND (//)
The search found %u devices
MSG_FOUND_ONE (//)
The search found one device
MSG_FOUND_NONE (//)
The search found no devices
;
; What a call that did not work says, after what it was.
MSG_NOT_SET (//)
Not changed: %s
MSG_NOT_SEARCHING (//)
No search: %s
;
; What is under way with a device, and how it went: its name, and why
; where it did not work.
MSG_PAIRING (//)
Pairing with %s...
MSG_PAIRED (//)
Paired with %s
MSG_NOT_PAIRED (//)
Not paired with %s: %s
MSG_CONNECTING (//)
Connecting to %s...
MSG_CONNECTED (//)
Connected to %s
MSG_NOT_CONNECTED (//)
Not connected to %s: %s
MSG_DISCONNECTING (//)
Disconnecting from %s...
MSG_DISCONNECTED (//)
Disconnected from %s
MSG_NOT_DISCONNECTED (//)
Not disconnected from %s: %s
MSG_FORGETTING (//)
Forgetting %s...
MSG_FORGOTTEN (//)
%s is forgotten
MSG_NOT_FORGOTTEN (//)
%s is not forgotten: %s
;
; Why: what went wrong.
MSG_WHY_NOMEM (//)
there is not the memory
MSG_WHY_OPENFAIL (//)
its device did not open
MSG_WHY_TIMEOUT (//)
it was not answered in time
MSG_WHY_DETACHED (//)
the controller has gone
MSG_WHY_PROTOCOL (//)
its device failed
MSG_WHY_NOCONTROLLER (//)
there is no such controller
MSG_WHY_NOTUP (//)
the controller is not up
MSG_WHY_OFF (//)
the controller is off
MSG_WHY_UNSUPPORTED (//)
the controller cannot do that
MSG_WHY_BUSY (//)
the controller is busy with something else
MSG_WHY_UNKNOWN_COMMAND (//)
it does not take a command it needs
MSG_WHY_HARDWARE (//)
a hardware failure
MSG_WHY_REFUSED (//)
the controller refused
MSG_WHY_NO_ROOM (//)
the controller has no room for another, or there is not the memory
MSG_WHY_BONDED (//)
this machine has a bond with it already
MSG_WHY_NOT_BONDED (//)
this machine has no bond with it
MSG_WHY_NOT_LINKED (//)
there is no link to it
MSG_WHY_ANSWER_REFUSED (//)
refused, or not answered in time
MSG_WHY_NO_ANSWER (//)
the device did not answer
MSG_WHY_LOST (//)
the link was lost
MSG_WHY_DEVICE_ENDED (//)
the device ended the link
MSG_WHY_ENDED_HERE (//)
the link was ended here
MSG_WHY_DEVICE_REFUSED (//)
the device refused
MSG_WHY_NUMBERS (//)
the device refused, or the numbers did not match
MSG_WHY_KEY_MISSING (//)
no PIN, or the device no longer has the key: forget it and pair again
MSG_WHY_NOT_PAIRING (//)
the device does not pair now
MSG_WHY_REPEATED (//)
the device wants a pause before the next try
MSG_WHY_SHORT_KEY (//)
the key is too short
;
; A device's row: its name where it has none, its signal, its state and
; its address.
MSG_NO_NAME (//)
(no name)
MSG_SIGNAL (//)
%d dBm, %s
MSG_SIGNAL_EXCELLENT (//)
excellent
MSG_SIGNAL_GOOD (//)
good
MSG_SIGNAL_FAIR (//)
fair
MSG_SIGNAL_WEAK (//)
weak
MSG_STATE_PAIRED (//)
paired
MSG_STATE_CONNECTED (//)
connected
MSG_STATE_ENCRYPTED (//)
encrypted
MSG_STATE_PAIRING (//)
pairing
MSG_ADDRESS_LE (//)
%s (LE)
MSG_ADDRESS_RANDOM (//)
%s (LE, random)
;
