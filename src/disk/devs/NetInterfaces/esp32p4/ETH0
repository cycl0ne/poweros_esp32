/* DEVS:NetInterfaces/ETH0 - the interface C:net/AddNetInterface ETH0
 * brings up as eth0. The startup-sequence brings up every file here.
 *
 * This one is the board's Ethernet port, its address from the network's
 * DHCP server. A fixed address instead would be, for example
 *   Configure = FIXED; Address = 192.168.1.50; NetMask = 255.255.255.0
 *   Gateway = 192.168.1.1; NameServer = 192.168.1.1
 * On a board without an Ethernet port the interface is not added, and
 * nothing is said. A keyword this file does not know is an error, with
 * its line and column; see C:net/AddNetInterface for the list.
 */
Device     = networks/emac.device
Unit       = 0
Configure  = DHCP
