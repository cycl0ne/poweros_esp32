# The flat look, every change of a button or a field fading over a fifth of a second.
PART=MAIN BORDER=FLAT BORDERCOLOUR=#404850 BORDERWIDTH=1 RADIUS=8 BACKGROUND=#FAFBFC..#D8DCE2 PADDINGX=6 PADDINGY=3 TRANSITION=200
PART=MAIN STATE=HOVERED BORDERCOLOUR=#3A6EA5 BACKGROUND=#FFFFFF..#E4ECF6
PART=MAIN STATE=PRESSED BORDER=FLAT BACKGROUND=#3A6EA5 TEXT=#FFFFFF
PART=MAIN STATE=CHECKED BORDER=FLAT BACKGROUND=#3A6EA5 TEXT=#FFFFFF
PART=FIELD BORDER=FLAT BORDERCOLOUR=#8890A0 BORDERWIDTH=1 RADIUS=4 BACKGROUND=#FFFFFF TRANSITION=200
PART=FIELD STATE=HOVERED BORDERCOLOUR=#3A6EA5
PART=FIELD STATE=FOCUSED BORDERCOLOUR=#3A6EA5 BACKGROUND=#E8F0FF
PART=CHECKMARK BACKGROUND=#FFFFFF
PART=SELECTION BACKGROUND=#2F6FD0 TEXT=#FFFFFF
