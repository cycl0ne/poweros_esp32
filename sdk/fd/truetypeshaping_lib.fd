// SPDX-License-Identifier: MIT
//! truetypeshaping.library's functions: a text, or a run of glyphs,
//! shaped by a font's layout tables - replaced, and placed.
//! Open it with OpenLibrary("truetypeshaping.library", 1).
##include libs/truetype/truetype as truetype
##include libs/truetypeshaping/truetypeshaping as truetypeshaping
##basetype TrueTypeShapingBase
##name truetypeshaping.library
##bias 4
##public
/// The glyphs of `run` shaped by `outline`'s layout tables: the
/// `features` (a list ended by a tag of 0) of the `script` and
/// `language` applied, each glyph given its advance and its offsets, in
/// the font's units. TTS_OK, or TTSERR_ROOM with the count the run
/// needs, TTSERR_NOMEM, TTSERR_DIRECTION, TTSERR_FEATURES.
i32 ShapeGlyphs(*truetype.Outline outline, u32 script, u32 direction, u32 language, ?[*]const truetypeshaping.Feature features, *truetypeshaping.ShapedRun run)
/// The `length` bytes of UTF-8 at `text` shaped by `outline`: cut by
/// script, each character made its glyph, and the features a text is
/// shaped with applied, changed by `features` (a list ended by a tag of
/// 0, its places in bytes). The glyphs come in `run`, as they are
/// drawn, each cluster the place of its first byte. TTS_OK, or
/// TTSERR_ROOM with the count the run needs, TTSERR_NOMEM,
/// TTSERR_DIRECTION, TTSERR_FEATURES.
i32 ShapeText(*truetype.Outline outline, [*]const u8 text, u32 length, u32 direction, u32 language, ?[*]const truetypeshaping.Feature features, *truetypeshaping.ShapedRun run)
/// The places inside the ligature `glyph` where the cursor may stand, as
/// the font's GDEF names them, in its units from the glyph's point: how
/// many there are, the first `room` of them written to `carets`.
u32 LigatureCarets(*truetype.Outline outline, u32 glyph, [*]i32 carets, u32 room)
##end
