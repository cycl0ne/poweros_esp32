// SPDX-License-Identifier: MIT
//! bluetooth.library's functions: the Bluetooth controllers, brought up
//! and run by the library's task, the devices they find, their links to
//! them and their bonds with them, the channels to the devices' protocols
//! and the services they offer, and who is told when they change.
//! Open it with OpenLibrary("bluetooth.library", 1); the structures are
//! in sdk.bluetooth.
##include libs/exec/exec as exec
##include libs/utility/utility as utility
##include libs/bluetooth/bluetooth as bluetooth
##basetype BluetoothBase
##name bluetooth.library
##bias 4
##public
// Controllers
/// A controller offered by its driver: the device's unit opened by the library's task, which brings it up. The controller's number, or BTERR_*.
i32 AddBTController([*:0]const u8 device_name, u32 unit)
/// A controller taken back by its driver: closed, and gone from the list, before the call returns.
void RemBTController([*:0]const u8 device_name, u32 unit)
/// The controllers as they are now: a list of BTController, the caller's until ReleaseBTControllers; null for no memory.
?*exec.List ObtainBTControllers()
/// A list from ObtainBTControllers given back. Null does nothing.
void ReleaseBTControllers(?*exec.List list)
// Notification
/// A task signalled whenever the controllers change; null for no memory.
?*bluetooth.BTNotify AddBTNotify(*exec.Task task, u32 signals)
/// A notification given back: its task is told no more. Null does nothing.
void RemBTNotify(?*bluetooth.BTNotify notify)
// Settings
/// A controller's settings changed by the tags (BTCA_*): on or off, its name, whether others find it. 0, or BTERR_*.
i32 SetBTControllerAttrs(u32 controller, ?[*]const utility.TagItem tags)
// Discovery
/// A controller made to look for the devices around for about `seconds`: LE's advertising, an inquiry, the names not heard. 0, or BTERR_*.
i32 StartBTDiscovery(u32 controller, u32 seconds)
/// A controller's discovery ended now; what it found stays listed.
void StopBTDiscovery(u32 controller)
/// The devices a controller found - or every controller, BT_ALL_CONTROLLERS: a list of BTDevice, the caller's until ReleaseBTDevices; null for no memory.
?*exec.List ObtainBTDevices(u32 controller)
/// A list from ObtainBTDevices given back. Null does nothing.
void ReleaseBTDevices(?*exec.List list)
// Connections
/// A link made to a device - paged over BR/EDR, initiated to over LE - and waited for. 0 once it is up, BTERR_*, or the controller's status.
i32 ConnectBTDevice(u32 controller, *const bluetooth.BTAddress address)
/// A link to a device ended, and waited for. 0 once it is down, BTERR_*, or the controller's status.
i32 DisconnectBTDevice(u32 controller, *const bluetooth.BTAddress address)
/// The links as they are now - or every controller's, BT_ALL_CONTROLLERS: a list of BTConnection, the caller's until ReleaseBTConnections; null for no memory.
?*exec.List ObtainBTConnections(u32 controller)
/// A list from ObtainBTConnections given back. Null does nothing.
void ReleaseBTConnections(?*exec.List list)
// Pairing
/// A pairing with a device begun, over BR/EDR or LE, its link made first where there is none: 0 once it has begun, BTERR_*, or the controller's status. What it needs to know and its end go to `agent`.
i32 PairBTDevice(u32 controller, *const bluetooth.BTAddress address, ?*bluetooth.BTAgent agent)
/// A bond ended: its key forgotten, its file deleted, a link to the device ended. 0, or BTERR_*.
i32 UnpairBTDevice(u32 controller, *const bluetooth.BTAddress address)
/// An agent added: `port` sent what a pairing needs to know (BTAgentMessage), `capability` what its user can do (BTIO_*); null for no memory.
?*bluetooth.BTAgent AddBTAgent(*exec.MsgPort port, u32 capability)
/// An agent given back: asked nothing more, its pairings refused; what is still on its port is the caller's to reply. Null does nothing.
void RemBTAgent(?*bluetooth.BTAgent agent)
/// The bonds of a controller - or every controller's, BT_ALL_CONTROLLERS: a list of BTBond, the caller's until ReleaseBTBonds; null for no memory.
?*exec.List ObtainBTBonds(u32 controller)
/// A list from ObtainBTBonds given back. Null does nothing.
void ReleaseBTBonds(?*exec.List list)
// Channels
/// A channel opened to a protocol of a device, by its PSM, over BR/EDR, its link made first where there is none: 0 once it is open and `channel` set, BTERR_*, or the controller's status. Its frames come to `port`.
i32 OpenBTChannel(u32 controller, *const bluetooth.BTAddress address, u32 psm, *exec.MsgPort port, *?*bluetooth.BTChannel channel)
/// A channel closed and given back; the messages about it still on its port taken back. Null does nothing.
void CloseBTChannel(?*bluetooth.BTChannel channel)
/// A frame sent on a channel, waiting while the controller's queue is full: 0 once it is queued, or BTERR_*.
i32 SendBTChannel(*bluetooth.BTChannel channel, [*]const u8 data, u32 length)
/// A PSM served: the channels devices open to it come to `port` as BTCM_OPENED; null for no memory, or a PSM taken or one no channel can name.
?*bluetooth.BTListener AddBTListener(u32 psm, *exec.MsgPort port)
/// A listener given back: devices' channels to its PSM refused again; what is still on its port is the caller's. Null does nothing.
void RemBTListener(?*bluetooth.BTListener listener)
// Services
/// The services a device offers, asked of its SDP server: 0 and `list` set to a list of BTService, the caller's until ReleaseBTServices, BTERR_*, or the controller's status.
i32 ObtainBTServices(u32 controller, *const bluetooth.BTAddress address, *?*exec.List list)
/// A list from ObtainBTServices given back. Null does nothing.
void ReleaseBTServices(?*exec.List list)
##end
