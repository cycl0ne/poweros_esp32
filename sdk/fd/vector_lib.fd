// SPDX-License-Identifier: MIT
//! vector.library's functions: paths of lines and curves in a program's
//! own units, filled or stroked with smooth edges onto its pens through a
//! matrix. Open it with OpenLibrary("vector.library", 1).
##include libs/graphics/graphics as graphics
##include libs/utility/utility as utility
##include libs/vector/vector as vector
##basetype VectorBase
##name vector.library
##bias 4
##public
/// An empty path; null without the memory for one.
?*vector.Path CreatePath()
/// A path given back. Null does nothing.
void DisposePath(?*vector.Path path)
/// The path emptied, its memory kept for the next one built in it.
void ClearPath(*vector.Path path)
/// A new contour started at (x, y).
void MoveTo(*vector.Path path, f32 x, f32 y)
/// A line from the current point to (x, y).
void LineTo(*vector.Path path, f32 x, f32 y)
/// A quadratic curve from the current point to (x, y), pulled toward (x1, y1).
void QuadTo(*vector.Path path, f32 x1, f32 y1, f32 x, f32 y)
/// A cubic curve from the current point to (x, y), leaving toward (x1, y1) and arriving from (x2, y2).
void CubicTo(*vector.Path path, f32 x1, f32 y1, f32 x2, f32 y2, f32 x, f32 y)
/// The contour closed back to where it started.
void ClosePath(*vector.Path path)
/// A canvas over the caller's pens (VCA_*); null without a size or the memory.
?*vector.Canvas CreateCanvasTagList(?[*]const utility.TagItem tags)
/// A canvas given back; its pens stay the caller's. Null does nothing.
void DisposeCanvas(?*vector.Canvas canvas)
/// The pens the canvas draws on from now on; null draws nothing.
void SetCanvasPens(*vector.Canvas canvas, ?[*]graphics.Pen pens, u32 bytes_per_row)
/// The path filled through the matrix (null: the identity) in the paint, by the rule (RULE_*).
i32 FillPath(*vector.Canvas canvas, *const vector.Path path, ?*const vector.Matrix matrix, *const vector.Paint paint, u32 rule)
/// The path stroked in its own units, then through the matrix (null: the identity), in the paint.
i32 StrokePath(*vector.Canvas canvas, *const vector.Path path, ?*const vector.Matrix matrix, *const vector.Paint paint, *const vector.Stroke stroke)
/// SVG's elliptical arc from the current point to (x, y): the radii, the ellipse's angle in degrees, ARC_LARGE and ARC_SWEEP.
void ArcTo(*vector.Path path, f32 rx, f32 ry, f32 angle, u32 flags, f32 x, f32 y)
/// A closed rectangle, its corners rounded rx across and ry down; SVG's rect.
void AddRect(*vector.Path path, *const vector.Rect rect, f32 rx, f32 ry)
/// A closed ellipse round (cx, cy); SVG's ellipse.
void AddEllipse(*vector.Path path, f32 cx, f32 cy, f32 rx, f32 ry)
/// SVG path data onto the path: VECTORERR_SYNTAX at the first error, the path kept up to it.
i32 AddPathData(*vector.Path path, [*]const u8 text, u32 length)
/// The bounds of the path's curves through the matrix (null: the identity); false for an empty path.
bool PathBounds(*const vector.Path path, ?*const vector.Matrix matrix, *vector.Rect bounds)
/// What is drawn until PopLayer goes onto a layer of its own, put down at the opacity.
i32 PushLayer(*vector.Canvas canvas, f32 opacity)
/// The last layer pushed put down on what is under it.
void PopLayer(*vector.Canvas canvas)
/// Segments onto the path in one call: a verb each (SEG_*) and the points they take, in order; VECTORERR_SYNTAX at a verb it does not know or short of points, the path kept up to it.
i32 AddSegments(*vector.Path path, [*]const u8 verbs, u32 verb_count, [*]const vector.Point points, u32 point_count)
/// What is drawn until PopClip shows only inside the path, through the matrix (null: the identity), by the rule (RULE_*).
i32 PushClip(*vector.Canvas canvas, *const vector.Path path, ?*const vector.Matrix matrix, u32 rule)
/// The last clip or mask pushed taken off.
void PopClip(*vector.Canvas canvas)
/// What is drawn until EndMask makes a mask rather than being seen.
i32 BeginMask(*vector.Canvas canvas)
/// The drawing since BeginMask made a mask (MASK_*) that clips what is drawn until PopClip.
i32 EndMask(*vector.Canvas canvas, u32 kind)
/// What is drawn on the last layer pushed blurred, as SVG's
/// feGaussianBlur, `deviation_x` across and `deviation_y` down in pixels:
/// VECTOR_OK, or VECTORERR_DEPTH with no layer. Since 1.4.
i32 BlurLayer(*vector.Canvas canvas, f32 deviation_x, f32 deviation_y)
##end
