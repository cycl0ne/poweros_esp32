// SPDX-License-Identifier: MIT
//! rtg.library's functions for programs: the displays of this machine. A
//! caller walks the boards the drivers made, the first of which is the
//! machine's display; a board has
//! modes, display memory, a buffer it is shown out of and a blanking. The
//! library draws nothing of its own - an operation a board's engine can do
//! is offered through the board, and a board that has not got it says so.
//! Open it with OpenLibrary("rtg.library", 1). What a driver calls is the
//! library's second interface, sdk/fd/rtgdriver_lib.fd.
##include libs/exec/exec as exec
##include libs/utility/utility as utility
##include libs/rtg/rtg as rtg
##basetype RtgBase
##name rtg.library
##bias 4
##public
// Eight slots kept free, so the slots after them stay where they are.
##reserve 8
/// The next board after `after`, or the first for null: the machine's
/// display. A board whose device has gone is passed over.
?*rtg.RtgBoard NextBoard(?*rtg.RtgBoard after)
/// The board of that name ("rgb.0"), gone or not, or null.
?*rtg.RtgBoard FindBoard([*:0]const u8 board_name)
/// Fill in `info`, of which `size` bytes are there - pass
/// @sizeOf(RtgBoardInfo). Returns the bytes written; check it before
/// trusting a field near the end.
u32 GetBoardInfo(*rtg.RtgBoard board, *rtg.RtgBoardInfo info, u32 size)
/// What a board that refreshes itself has been through. Same rule as
/// GetBoardInfo. All zeroes for a board that counts nothing.
u32 GetBoardStats(*rtg.RtgBoard board, *rtg.RtgBoardStats stats, u32 size)
/// Something only this driver knows about (RTGCTRL_*), or
/// RTGCTRL_RESET_STATS, which every board takes. RTGERR_NOT_SUPPORTED for
/// one it does not know.
isize BoardControl(*rtg.RtgBoard board, u32 what, isize value)
// A slot kept free, so the slots after it stay where they are.
##reserve 1
/// The number of the board's mode of exactly that size, refresh (in
/// milli-Hertz) and format, or 0. RTG_ANY matches whatever, so all four
/// RTG_ANY is the board's default mode.
u32 FindBoardMode(*rtg.RtgBoard board, u32 width, u32 height, u32 refresh_mhz, u32 format)
// Two slots kept free, so the slots after them stay where they are.
##reserve 2
/// A buffer in the board's display memory, its rows aligned as the board
/// asks. RTGBMF_DISPLAYABLE makes one the board can be shown. Null: a
/// size of 0, a format this build does not know, a board with no display
/// memory, or no room.
?*rtg.RtgBitMap AllocBitMap(*rtg.RtgBoard board, u32 width, u32 height, u32 format, u32 flags)
/// A buffer over memory the caller owns: the seven fields of a surface are
/// read out of `described` and nothing is allocated. Null: no pixels, a
/// size of 0, a pitch shorter than a row, a format this build does not
/// know, or no memory.
?*rtg.RtgBitMap AttachBitMap(*rtg.RtgBoard board, *const rtg.RtgBitMap described)
/// Give a buffer back. Refused while the board is showing it. Null does
/// nothing.
void FreeBitMap(?*rtg.RtgBitMap bitmap)
/// Show that buffer, whole, in the mode the board is in - its default
/// where it is in none; null shows nothing.
i32 ShowBitMap(*rtg.RtgBoard board, ?*rtg.RtgBitMap bitmap)
/// The buffer the board is showing, or null. Its first seven fields are a
/// drawing surface.
?*rtg.RtgBitMap BoardDisplayBitMap(*rtg.RtgBoard board)
// A slot kept free, so the slots after it stay where they are.
##reserve 1
/// Wait for `frames` frames of the display to end; 0 is the next one.
/// For the frames the board's driver says ended, RTGERR_TIMEOUT when
/// they do not come within two frames' time each; by the clock on a
/// board that says none. Not from interrupts.
i32 WaitVBlank(*rtg.RtgBoard board, u32 frames)
/// Put the board in a power state: RTGPWR_ON, the picture shown;
/// RTGPWR_BLANK, the picture black; RTGPWR_ASLEEP, the display asleep.
/// Answers the state it is in then - RTGPWR_BLANK for a board that does
/// not sleep by itself - or an error below 0. What is shown or drawn
/// meanwhile is kept, and the backlight comes back as it was.
i32 SetBoardPower(*rtg.RtgBoard board, u32 state)
/// The backlight, 0 to 100, the right way round whatever the part does;
/// the library keeps the value, and GetBoardInfo answers it.
/// RTGERR_NOT_SUPPORTED without RTGBC_BRIGHTNESS.
i32 SetBoardBrightness(*rtg.RtgBoard board, u32 percent)
// A slot kept free, so the slots after it stay where they are.
##reserve 1
/// Fill a rectangle, in the buffer's format, right-aligned. The rectangle
/// is cut down to the buffer first; nothing of it inside is RTGERR_OK and
/// no work. RTGERR_NOT_SUPPORTED unless the board's engine fills - the
/// library does not draw.
i32 FillRect(*rtg.RtgBitMap dest, *const rtg.RtgRect area, u32 color)
// A slot kept free, so the slots after it stay where they are.
##reserve 1
/// Copy a rectangle. The two buffers may be one and the rectangles may
/// overlap. Same rules as FillRect.
i32 CopyRect(*rtg.RtgBitMap src, *rtg.RtgBitMap dest, *const rtg.RtgCopy copy)
/// A one-bit shape in two colours. Same rules as FillRect.
i32 BlitTemplate(*rtg.RtgBitMap dest, *const rtg.RtgRect area, *const rtg.RtgTemplate shape)
/// A one-bit tile, anchored to the buffer. Same rules as FillRect.
i32 BlitPattern(*rtg.RtgBitMap dest, *const rtg.RtgRect area, *const rtg.RtgPattern tile)
// Fourteen slots kept free, so the slots after them stay where they are.
##reserve 14
/// An error in words. Never null.
[*:0]const u8 RtgErrorText(i32 error_code)
/// Mirror the picture about each axis, or show it unturned: the
/// picture, the overlay and the pointer alike, on the way to the glass.
/// RTGERR_NOT_SUPPORTED for an axis the board has no cap for
/// (RTGBC_MIRROR_X, RTGBC_MIRROR_Y); nothing changes then.
i32 MirrorBoard(*rtg.RtgBoard board, bool mirror_x, bool mirror_y)
// Two slots kept free, so the slots after them stay where they are.
##reserve 2
/// The pointer's image: a surface with an alpha channel, whose pixel
/// (hot_x, hot_y) is the point. Converted once, into the board's format
/// with a mask. Null takes the image away. RTGERR_NOT_SUPPORTED unless
/// a pointer is laid over the board's picture (RTGBC_POINTER).
i32 SetBoardPointer(*rtg.RtgBoard board, ?*const rtg.Surface image, u32 hot_x, u32 hot_y)
/// Put the pointer's point at (x, y), in the coordinates a caller draws
/// in. Made to be called on every pointer event, from a task: it may
/// wait for a display that is sent its picture.
void MoveBoardPointer(*rtg.RtgBoard board, i32 x, i32 y)
/// Lay the pointer over the picture, or stop.
i32 ShowBoardPointer(*rtg.RtgBoard board, bool show)
// A slot kept free, so the slots after it stay where they are.
##reserve 1
/// A second image laid over the picture under the pointer - a dragged
/// icon - converted once with its coverage dithered into a mask; it
/// follows the pointer, its pixel (hot_x, hot_y) at the pointer's point.
/// Null takes it away. RTGERR_NOT_SUPPORTED without RTGBC_OVERLAY.
i32 SetBoardOverlay(*rtg.RtgBoard board, ?*const rtg.Surface image, u32 hot_x, u32 hot_y)
/// Put the overlay's point at (x, y), and keep it there rather than with
/// the pointer.
void MoveBoardOverlay(*rtg.RtgBoard board, i32 x, i32 y)
/// Lay pixels of one's own over a rectangle, each by its own coverage
/// times `alpha` (0 to 255). The rectangle is cut down to the buffer, and
/// the pixels' corner moves with the cut. RTGERR_NOT_SUPPORTED unless the
/// board's engine takes the job.
i32 BlendPixels(*rtg.RtgBitMap dest, *const rtg.RtgRect area, *const rtg.RtgPixels pixels, u32 alpha)
/// Lay a colour, 0xAARRGGBB, over a rectangle by its alpha. Same rules
/// as FillRect.
i32 BlendRect(*rtg.RtgBitMap dest, *const rtg.RtgRect area, u32 color)
/// Scale a part of pixels of one's own, `width` by `height` from the
/// pixels' corner, to the rectangle's size, mixing neighbouring pixels,
/// and lay it over the rectangle by its coverage. The rectangle is not
/// cut: one not wholly inside the buffer is RTGERR_NOT_SUPPORTED, as is
/// any job the board's engine does not take.
i32 ScalePixels(*rtg.RtgBitMap dest, *const rtg.RtgRect area, *const rtg.RtgPixels pixels, u32 width, u32 height)
/// A rectangle of a buffer was written: hand its pixels on to the
/// display. Null is the whole buffer. What a caller that wrote the
/// pixels itself calls when it has finished. Cut down to the buffer.
i32 RefreshRect(*rtg.RtgBitMap bitmap, ?*const rtg.RtgRect area)
/// Copy several rectangles of one buffer on to another as one job, each
/// as CopyRect copies it and cut down to both buffers: the pieces of a
/// window seen between others, copied by the board's engine at once
/// rather than one after another. The rectangles do not overlap where they
/// land, and the two buffers are not one. RTGERR_NOT_SUPPORTED unless the
/// board's engine takes them.
i32 CopyRects(*rtg.RtgBitMap src, *rtg.RtgBitMap dest, [*]const rtg.RtgCopy copies, u32 count)
/// One of the board's video layers - a plane that shows a picture in YUV
/// itself, scaled into a place - under the picture (RTGVA_Under, the
/// default) or over it. Null without RTGBC_VIDEO, when its layers are all
/// taken, or for a picture whose colours the plane cannot make.
?*rtg.RtgVideoLayer OpenVideoLayer(*rtg.RtgBoard board, ?[*]const utility.TagItem tag_list)
/// Give a layer back: nothing shown on it from the next frame. Null does
/// nothing.
void CloseVideoLayer(?*rtg.RtgVideoLayer layer)
/// Show `src` of a picture on the layer from the next frame, scaled into
/// its place; returns once the controller has taken it, so the picture
/// shown before may be given back. Null shows nothing. A picture needs
/// its part. RTGERR_BAD_ARG for one the plane cannot read or scale.
i32 ShowVideoFrame(*rtg.RtgVideoLayer layer, ?*const rtg.RtgYuv picture, ?*const rtg.RtgRect src)
/// The layer's place, in the display's coordinates, from the next frame;
/// an empty rectangle hides it.
i32 MoveVideoLayer(*rtg.RtgVideoLayer layer, *const rtg.RtgRect place)
/// Bits a pixel of that format takes; 0 for a format this build does not
/// know.
u32 RtgFormatBits(u32 format)
/// Bytes a row of `width` pixels of that format needs, before any rounding
/// a board asks for; 0 for a format not known.
u32 RtgRowBytes(u32 format, u32 width)
/// One of H.273's numbers as rtg says it: `kind` is the table it is of
/// (RTGCICP_MATRIX, RTGCICP_TRANSFER, RTGCICP_PRIMARIES). Below zero
/// where the number says nothing, or names what no board here shows.
i32 RtgCicp(u32 kind, u32 value)
/// Offer every device no driver has to the drivers on the list: a panel of
/// the board's list, a display function on PCI. The driver that takes one
/// makes a board for each of its outputs. Answers how many boards were
/// made. graphics.library calls it as the machine starts. Not from
/// interrupts.
u32 BindRtgDrivers()
/// Copy out up to `count` of the drivers on the list, highest priority
/// first; answers how many there are. Null and 0 ask for the number alone.
u32 GetRtgDrivers(?[*]rtg.RtgDriverInfo into, u32 count)
/// The same for the devices, in the order they were found.
u32 GetRtgDevices(?[*]rtg.RtgDeviceInfo into, u32 count)
/// Copy out up to `count` of the board's modes, the largest picture
/// first; answers how many there are. Null and 0 ask for the number
/// alone.
u32 GetBoardModes(*rtg.RtgBoard board, ?[*]rtg.RtgMode into, u32 count)
/// The number of the board's mode nearest a wish - that size if it has
/// it, else the smallest that holds it, else its largest - and what it is,
/// into `mode`. RTG_ANY leaves a figure open. Never 0 on a board that has
/// a mode: on a display of one mode always that mode, and the caller
/// compares what it asked for with what came back.
u32 BestBoardMode(*rtg.RtgBoard board, u32 width, u32 height, u32 refresh_mhz, u32 format, ?*rtg.RtgMode mode)
/// What is on the board's connector, into `info`, of which `size` bytes
/// are there - pass @sizeOf(RtgMonitorInfo). Returns the bytes written.
/// A panel is a monitor that is always there.
u32 GetBoardMonitor(*rtg.RtgBoard board, *rtg.RtgMonitorInfo info, u32 size)
/// Copy out the EDID of the monitor on the board, up to `size` bytes;
/// answers its length, 0 for none. Null and 0 ask for the length alone.
u32 ReadBoardEDID(*rtg.RtgBoard board, ?[*]u8 buffer, u32 size)
/// Have `task` signalled with `signals` whenever something about the
/// boards changed: a board made or gone, a monitor come or gone, a list
/// of modes made again, a mode set. The task then reads the boards, and
/// each board's `changes`. Null without memory, or for no signals.
?*rtg.RtgNotify AddRtgNotify(*exec.Task task, u32 signals)
/// Give a notification back. Null does nothing.
void RemRtgNotify(?*rtg.RtgNotify notify)
/// Put the board in the mode of that number - 0 keeps the mode it is in,
/// or takes its default where it is in none - and show these bands in it,
/// each a buffer from a display line down: a screen pulled down shows
/// the one behind above it. A buffer of another width than the mode's
/// is shown scaled by the widths, on a board with RTGBC_SCALE_BANDS.
/// `count` 0 shows nothing. One step: a show that fails changes nothing.
i32 ShowBoard(*rtg.RtgBoard board, u32 mode_id, ?[*]const rtg.RtgBand bands, u32 count)
##end
