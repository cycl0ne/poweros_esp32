//! rdb.library's functions: a disk's RigidDiskBlock and partitions read
//! into memory, changed there and written back. Open it with
//! OpenLibrary("rdb.library", 1); the structures are in sdk.rdb.
##include libs/rdb/rdb as rdb
##include libs/dos/gpt as gpt
##basetype RDBBase
##name rdb.library
##bias 4
##public
/// The RigidDiskBlock and partitions of a unit of a block device, read
/// into a handle; null, and why in `err`, when the device cannot be used.
?*rdb.RDBHandle OpenRDB([*:0]const u8 device, u32 unit, ?*i32 err)
/// The handle, its partitions and the device let go of.
void CloseRDB(?*rdb.RDBHandle handle)
/// A fresh RigidDiskBlock for the whole medium in the handle, with no
/// partitions: written by WriteRDB.
i32 InitRDB(*rdb.RDBHandle handle)
/// The partition after `previous` on the handle's list, or the first.
?*rdb.RDBPartition NextPartition(*rdb.RDBHandle handle, ?*rdb.RDBPartition previous)
/// The partition called `name`, in any case.
?*rdb.RDBPartition FindPartition(*rdb.RDBHandle handle, [*:0]const u8 name)
/// A new partition called `name` over cylinders `low_cyl` to `high_cyl`
/// (0 and 0: the largest free run) for the file system `dos_type`.
i32 AddPartition(*rdb.RDBHandle handle, [*:0]const u8 name, u32 low_cyl, u32 high_cyl, u32 dos_type)
/// A partition taken off the handle's list and freed.
void RemPartition(*rdb.RDBHandle handle, *rdb.RDBPartition partition)
/// The handle's table checked and written to the disk.
i32 WriteRDB(*rdb.RDBHandle handle)
/// A device node for a partition on dos's list, named as the partition
/// (with dots added while the name is taken), its handler started with
/// RDBMF_START; the name used goes where `name` points.
i32 MountPartition(*rdb.RDBHandle handle, *rdb.RDBPartition partition, ?*rdb.MountName name, u32 flags)
/// The file system after `previous` on the handle's list of the file
/// systems kept in the table, or the first.
?*rdb.RDBFileSystem NextFileSystem(*rdb.RDBHandle handle, ?*rdb.RDBFileSystem previous)
/// A handler's load file, `size` bytes at `code`, kept in the table for
/// the partitions of `dos_type` - in place of one kept for it already -
/// once WriteRDB writes it.
i32 AddFileSystem(*rdb.RDBHandle handle, u32 dos_type, [*]const u8 code, u32 size)
/// A file system taken out of the handle's table and freed.
void RemFileSystem(*rdb.RDBHandle handle, *rdb.RDBFileSystem file_system)
/// The GPT partition after `previous` on the handle's list, or the first.
?*rdb.GPTPartition NextGPTPartition(*rdb.RDBHandle handle, ?*rdb.GPTPartition previous)
/// A device node for a GPT partition on dos's list, named `name` (with
/// dots added while the name is taken), for the file system its first
/// block holds; the name used goes where `mounted` points.
i32 MountGPTPartition(*rdb.RDBHandle handle, *rdb.GPTPartition partition, [*:0]const u8 name, ?*rdb.MountName mounted, u32 flags)
/// A fresh GPT for the whole medium in the handle, with no partitions:
/// written by WriteGPT.
i32 InitGPT(*rdb.RDBHandle handle)
/// A new GPT partition, as `entry` gives its type, blocks (0 and 0: the
/// largest free run), attributes and name; null, and why in `err`, when
/// it cannot be one.
?*rdb.GPTPartition AddGPTPartition(*rdb.RDBHandle handle, *const gpt.Entry entry, ?*i32 err)
/// A GPT partition taken off the handle's list and freed.
void RemGPTPartition(*rdb.RDBHandle handle, *rdb.GPTPartition partition)
/// The handle's GPT checked and written to the disk, both copies.
i32 WriteGPT(*rdb.RDBHandle handle)
/// The handle's GPT taken out of it, for a table over the whole disk,
/// which WriteRDB writes and then wipes the disk's GPT.
void RemGPT(*rdb.RDBHandle handle)
##end
