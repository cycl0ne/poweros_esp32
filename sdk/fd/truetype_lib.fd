// SPDX-License-Identifier: MIT
//! truetype.library's functions: a TrueType file rendered into font
//! images, one size at a time, since 1.2 its glyphs as outlines, since
//! 1.4 a font of a collection, its names and its tables, since 1.5 one
//! glyph rendered by its number, since 1.6 an OpenType file whose
//! glyphs are of cubic curves (a CFF table's), since 1.7 a font
//! whose glyphs are pictures, of coverage or of colour, since 1.8 a
//! variable font at a place on its axes, since 1.10 a size's heights
//! on whole rows, and since 1.11 what a store of deltas adds there.
//! Open it with OpenLibrary("truetype.library", 1).
##include libs/utility/utility as utility
##include libs/graphics/graphics as graphics
##include libs/truetype/truetype as truetype
##basetype TrueTypeBase
##name truetype.library
##bias 4
##public
/// The font in `size` bytes at `file`, its tables found and checked; null
/// if it is not a font this library reads. `tags` say which font
/// of a collection (TTA_FontIndex) and where on a variable font's axes
/// (TTA_Axes, TTA_AxisCount); null for the first, at its default.
/// TTA_Plain opens it to be rendered scaled, no height moved to a row.
/// The bytes must stay until CloseOutline. Tags since 1.4, axes since
/// 1.8, TTA_Plain since 1.10.
?*truetype.Outline OpenOutline([*]const u8 file, u32 size, ?[*]const utility.TagItem tags)
/// The outline rendered `rows` rows tall as a font image: the characters
/// it has in the `count` sorted `ranges`, and its missing glyph as the
/// default; the caller frees it with FreeVec. Null for a height of 0 or
/// past 4096, a font with neither outlines nor pictures, ranges out of
/// order, or no memory. Ranges since 1.3.
?*graphics.fontimage.FontImage RenderFontImage(*truetype.Outline outline, u32 rows, [*]const truetype.CodeRange ranges, u32 count)
/// What OpenOutline made, given back. Null does nothing.
void CloseOutline(?*truetype.Outline outline)
/// The glyph a character is (a Unicode code point), from the font's
/// character map; 0, the missing glyph, when it has none. Since 1.2.
u32 GlyphIndex(*truetype.Outline outline, u32 code)
/// A glyph's advance, left side bearing and box into `metrics`, in the
/// font's units; false for no glyph of that number. Since 1.2.
bool GlyphMetrics(*truetype.Outline outline, u32 glyph, *truetype.GlyphMetrics metrics)
/// A glyph's outline as verbs and points into `segments`' arrays, in the
/// font's units, y up: TRUETYPE_OK, or TRUETYPEERR_ROOM with the counts
/// it needs. Since 1.2.
i32 GlyphSegments(*truetype.Outline outline, u32 glyph, *truetype.Segments segments)
/// The font's measures into `metrics`. Since 1.2.
void FontMetrics(*truetype.Outline outline, *truetype.FontMetrics metrics)
/// How much further apart the font draws `left` and `right` side by
/// side, in its units: negative for closer. Since 1.2.
i32 Kerning(*truetype.Outline outline, u32 left, u32 right)
/// The glyph a character is when the variation selector `selector`
/// follows it, from the font's variation sequences; 0 when the font has
/// none for the two. Since 1.4.
u32 GlyphVariant(*truetype.Outline outline, u32 code, u32 selector)
/// One of the font's names (TTNAME_FAMILY, ...) as UTF-8 into `buffer`,
/// NUL-terminated and cut to `room` bytes; the bytes the whole name
/// takes, 0 when the font has no such name. Since 1.4.
u32 FontName(*truetype.Outline outline, u32 name, [*]u8 buffer, u32 room)
/// The bytes of the table `tag` names (four letters, the first highest),
/// its length into `length`; null and 0 when the font has none. They are
/// the file's own bytes. Since 1.4.
?[*]const u8 FontTable(*truetype.Outline outline, u32 tag, *u32 length)
/// One glyph, by its number, rendered for a line `rows` tall into
/// `image`'s bytes, with its box and advance as a font image has a
/// glyph's: TRUETYPE_OK, or TRUETYPEERR_ROOM with the bytes it needs.
/// `image.kind` says what a pixel is. Since 1.5.
i32 RenderGlyph(*truetype.Outline outline, u32 glyph, u32 rows, *truetype.GlyphImage image)
/// How many axes a variable font has, 0 for any other; up to `room` of
/// them go into `axes`, each with its range and the value this outline
/// was opened at. Since 1.8.
u32 FontAxes(*truetype.Outline outline, ?[*]truetype.Axis axes, u32 room)
/// The font's named instance `number`, counted from 0: its name as the
/// number FontName takes, and its value on each axis into `values`, up
/// to `room` of them, as TTA_Axes takes them. 0 when the font has no
/// instance of that number. Since 1.8.
u32 FontInstance(*truetype.Outline outline, u32 number, ?[*]truetype.AxisValue values, u32 room)
/// Where the outline was opened on each axis as shaping tables count
/// it: -16384 to 16384 for -1 to 1, the axis' default 0. Up to `room`
/// go into `coords`; answers the font's axis count. Since 1.8.
u32 FontCoordinates(*truetype.Outline outline, ?[*]i16 coords, u32 room)
/// A glyph's advance in the font's units, at the outline's place on
/// the axes; 0 for a number past the font's glyphs. Since 1.8.
i32 GlyphAdvance(*truetype.Outline outline, u32 glyph)
/// What the item `item` of the item variation store in `size` bytes at
/// `store` adds at the outline's place on the axes, in the font's
/// units, rounded: its data's number in the high 16 bits, its row's in
/// the low. 0 at the default. The number of the row's deltas goes into
/// `regions` when it is not null. Since 1.11.
i32 VariationDelta(*truetype.Outline outline, [*]const u8 store, u32 size, u32 item, ?*u32 regions)
##end
