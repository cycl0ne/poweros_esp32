// SPDX-License-Identifier: MIT
//! amdgpu.resource's functions: the machine's AMD graphics device, where
//! its register window is and where each of its blocks' registers are,
//! its blocks powered up and down, its own memory handed out, the
//! firmware its blocks run loaded through its security processor, and
//! its interrupts handed to the drivers of the blocks that raise them.
//! A resource: no Open or Close, its first function in the first slot.
//! The base comes from OpenResource("amdgpu.resource").
##include libs/exec/exec as exec
##include resources/amdgpu as amdgpu
##basetype AMDGPUBase
##name amdgpu.resource
##bias 0
##public
/// What the device is and where the machine reaches it, into `info`;
/// false on a machine without one.
bool GetGPUInfo(*amdgpu.GPUInfo info)
/// The device's block of kind `id` (GPUBLOCK_*), its `instance`th, into
/// `block`; false where the device has no such block, or there is no
/// device.
bool FindGPUBlock(u32 id, u32 instance, *amdgpu.GPUBlock block)
/// The device's `part` (GPUPOWER_*), its `instance`th, powered up - or
/// down, with `on` false - by its power manager; false where the manager
/// refused or did not answer, or there is no device.
bool SetGPUPower(u32 part, u32 instance, bool on)
/// `bytes` of the device's own memory, starting on a multiple of
/// `alignment`, into `memory`; false where there is no room, or no
/// device. Not cleared.
bool AllocGPUMemory(u32 bytes, u32 alignment, *amdgpu.GPUMemory memory)
/// A piece from AllocGPUMemory given back; `memory` is cleared.
void FreeGPUMemory(*amdgpu.GPUMemory memory)
/// The security processor made ready to load firmware: its ring made,
/// its table of contents - the file `toc`, `length` bytes, as it is on
/// the disk - loaded, and the protected region it asks for set up in the
/// device's memory. True once it is, and at once where it already is.
bool StartGPUSecurity([*]const u8 toc, u32 length)
/// The firmware file `image`, `length` bytes, of kind `kind`
/// (GPUFIRMWARE_*), loaded by the security processor into its protected
/// region; true with `address` holding where it is there, to the device.
bool LoadGPUFirmware(u32 kind, [*]const u8 image, u32 length, *u64 address)
/// `server` called, in the interrupt, for each entry of the device's
/// interrupt ring from `client` (GPUINT_CLIENT_*) with `source`, which it
/// is handed as its interrupt number; the ring is started with the first
/// server. False where there is no room for one more, the ring cannot be
/// started, or there is no device.
bool AddGPUIntServer(u32 client, u32 source, *exec.Interrupt server)
/// A server AddGPUIntServer added taken off again.
void RemGPUIntServer(*exec.Interrupt server)
/// The device's video BIOS image, as the machine's firmware kept it, into
/// `bios`; false where there is no device, or no image is the device's.
bool GetGPUBios(*amdgpu.GPUBios bios)
/// The device's connector `index` (from 0), as its video BIOS lists it,
/// into `connector`; false past the last one, or where there is no list.
bool GetGPUConnector(u32 index, *amdgpu.GPUConnector connector)
/// The graphics block's firmware - the files `files` names, each as it is
/// on the disk - loaded by the security processor in the order the
/// block's RLC takes it, the RLC told to hand each engine its code, the
/// block's power controller started by the power manager, and its memory
/// hub turned on once every engine has its code; true once all of it is
/// done.
bool StartGPUGraphics(*const amdgpu.GPUGraphicsFiles files)
/// The graphics block's DMA engine started with one queue of jobs, once
/// StartGPUGraphics has started the block; true once it runs.
bool StartGPUDMA()
/// The DMA engine's packets `packets`, `words` words of them, put on its
/// queue as one job; the job's number, for WaitGPUDMA, or 0 where the
/// queue does not run, the job does not fit in it, or the engine does not
/// make room for it in time.
u32 SendGPUDMA([*]const u32 packets, u32 words)
/// Waits until the DMA engine has done job `job`, `most_ms` milliseconds
/// at most; true once it has, false where it has not by then.
bool WaitGPUDMA(u32 job, u32 most_ms)
/// The DMA engine's queue as it is, into `state`; false where it does not
/// run.
bool GetGPUDMAState(*amdgpu.GPUDMAState state)
##end
