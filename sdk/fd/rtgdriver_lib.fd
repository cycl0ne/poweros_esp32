// SPDX-License-Identifier: MIT
//! rtg.library's functions for drivers: what a display's or a bus's
//! driver calls, as the library's second interface. The base is the one
//! OpenLibrary("rtg.library", 1) answers, seen as an RtgDriverBase; its
//! slots follow those of the programs' interface, sdk/fd/rtg_lib.fd, in
//! the one jump table.
##include libs/utility/utility as utility
##include libs/rtg/rtg as rtg
##basetype RtgDriverBase
##name rtg.library
// The folder under src/ whose files hold these calls.
##home rtg
// The first slot after the programs' calls.
##bias 77
##public
/// Put a driver's description on the list: the library makes the
/// driver's node, with the state the description asks for behind it,
/// cleared. `seg_list` is the segments of a driver that was loaded, null
/// for one in ROM. Null for a name already there, for ops that fill in
/// neither create, or without memory. Not from interrupts.
?*rtg.RtgDriver AddRtgDriver(*const rtg.RtgDriverSpec spec, ?*anyopaque seg_list)
/// Take a driver off the list and free its node and its state. False
/// while a board or a bus it made is still alive, and for one that is not
/// on the list. Not from interrupts.
bool RemRtgDriver(*rtg.RtgDriver driver)
/// Tell a board's servers that something happened. A driver calls it from
/// its own interrupt; returns what the chain answered.
i32 SignalRtgEvent(*rtg.RtgBoard board, u32 event)
/// A command and its parameters to the part. A command below zero sends
/// the parameters alone.
i32 TxParam(*rtg.RtgTransport io, i32 cmd, ?*const anyopaque param, u32 size)
/// A command and a run of pixels. It comes back when the bytes have gone.
i32 TxColor(*rtg.RtgTransport io, i32 cmd, ?*const anyopaque color, u32 size)
/// Send a command and read `size` bytes back, with nothing else reaching
/// the bus in between.
i32 RxParam(*rtg.RtgTransport io, i32 cmd, ?*anyopaque buffer, u32 size)
/// A tag's data, or `default_value` if it is not in the list. Here so a
/// driver need open nothing but this library.
usize GetRtgTagData(utility.Tag tag_value, usize default_value, ?[*]const utility.TagItem tag_list)
/// A board for one output of a device, from the driver's attach: the
/// handle and the instance the description asks for, cleared. It joins
/// the library's list, named, once the attach has answered RTGERR_OK.
/// Null: not inside the driver's attach for that device, or no memory.
?*rtg.RtgBoard CreateBoard(*rtg.RtgDriver driver, *rtg.RtgDevice device, *const rtg.RtgBoardSpec spec)
/// Give a board back: for an attach that fails after making one, and for
/// a driver that is being removed. Refused while an event server or a
/// video layer is still on it. Null does nothing.
void DeleteBoard(?*rtg.RtgBoard board)
/// A device the library cannot find by itself, made from tags that say
/// what a panel part's say (PART_Chip, PART_Bus, RTGA_*), and offered to
/// the drivers at once. The tags are read for as long as the device
/// lives. Null without memory.
?*rtg.RtgDevice AddRtgDevice(?[*]const utility.TagItem tag_list)
/// A device AddRtgDevice made is gone: its boards are marked gone and
/// stay handles, its driver's detach is called, and the device is freed.
/// Null does nothing.
void RemRtgDevice(?*rtg.RtgDevice device)
/// The bus a device is reached over, made by the transport driver whose
/// table names the device's bus, from the device's tags. Null: no such
/// driver, no memory, or a driver that could not make it.
?*rtg.RtgTransport OpenTransport(*rtg.RtgDriver driver, *rtg.RtgDevice device)
/// Give a bus back. Null does nothing.
void CloseTransport(?*rtg.RtgTransport io)
/// A mode of a board, from its driver: these timings in that pixel
/// format, with RTGMF_DEFAULT for the one the board comes up in and
/// RTGMF_TURNED for a picture a quarter turn round. The library names it
/// and gives it a number, which it answers; 0 for timings with no picture,
/// a format this build does not know, or no memory. A mode of the same
/// figures is the one already there.
u32 AddBoardMode(*rtg.RtgBoard board, *const rtg.RtgTimings timings, u32 format, u32 flags)
/// A part's timings - RTGA_Width, RTGA_Height and the block from
/// RTGA_PixelClock to RTGA_TimingFlags - into `timings`. False for a list
/// with no size, and for one that names a pixel clock without both sync
/// pulses; `timings` is then left as it was.
bool ReadTimingTags(?[*]const utility.TagItem tag_list, *rtg.RtgTimings timings)
##end
