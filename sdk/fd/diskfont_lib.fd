// SPDX-License-Identifier: MIT
//! diskfont.library's functions: fonts from FONTS:, any size of them,
//! and since 1.4 a family's outline itself. A font opened here is closed
//! with graphics' CloseFont. Open it with
//! OpenLibrary("diskfont.library", 1).
##include libs/utility/utility as utility
##include libs/graphics/graphics as graphics
##include libs/dos/dos as dos
##include libs/diskfont/diskfont as diskfont
##basetype DiskfontBase
##name diskfont.library
##bias 4
##public
/// The font nearest to `text_attr`: from memory, loaded from FONTS:, or
/// scaled from another size unless FPF_DESIGNED is asked. Null if the
/// font has no size that will do.
?*graphics.TextFont OpenDiskFont(*const graphics.TextAttr text_attr)
/// Every font in memory and in FONTS: (flags AFF_*) into `buffer`: an
/// AvailFontsHeader, the entries, their names. 0, or the bytes more it
/// needed.
u32 AvailFonts(*anyopaque buffer, u32 buffer_size, u32 flags)
/// A family's contents file made from its directory beside `lock`'s
/// directory; `name` ends in ".font". Null if there is nothing.
?*diskfont.fontfile.ContentsHeader NewFontContents(?*dos.FileLock lock, [*:0]const u8 name)
/// Free what NewFontContents made. Null does nothing.
void DisposeFontContents(?*diskfont.fontfile.ContentsHeader contents)
/// A new font of `text_attr`'s height from `font`, every glyph scaled.
/// Nobody else's: FreeVec frees it, after RemFont if it was added.
?*graphics.TextFont NewScaledDiskFont(*graphics.TextFont font, *const graphics.TextAttr text_attr)
/// A family's outline for truetype.library's calls: the face drawn in the
/// styles asked where the family has one, else the family's own. Null if
/// it has no outline. Since 1.4.
?*diskfont.OutlineFont OpenOutlineFont([*:0]const u8 name, graphics.FontStyle style)
/// What OpenOutlineFont gave, given back. Null does nothing. Since 1.4.
void CloseOutlineFont(?*diskfont.OutlineFont font)
/// Family `index` of those font.prefs names under FALLBACK, its name and
/// a NUL into `name`; false past the list's end or for too little room.
/// Since 1.16.
bool FallbackFamily(u32 index, [*]u8 name, u32 size)
/// The family whose fonts call themselves `name` - "Noto Sans" - or
/// whose contents file is `name` with ".font": that file's name and a
/// NUL into `into`; false for none or too little room. Since 1.16.
bool FindFamily([*:0]const u8 name, [*]u8 into, u32 size)
/// The family font.prefs names for the generic family `generic`
/// (GENERIC_*), its name and a NUL into `into`; false where it names
/// none and there is no default. Since 1.16.
bool GenericFamily(u32 generic, [*]u8 into, u32 size)
/// A family's outline in the face nearest the weight, width and slant
/// the tags ask (DFA_*), from the family and its faces, a variable font
/// at the place asked. Null if it has no outline. Since 1.16.
?*diskfont.OutlineFont OpenOutlineFontTagList([*:0]const u8 name, ?[*]const utility.TagItem tags)
##end
