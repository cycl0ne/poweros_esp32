// SPDX-License-Identifier: MIT
//! A codec module's functions (SINCE videocodec 1.4): what
//! videocodec.library calls a decoder of pictures in LIBS:codecs/ with,
//! after a module's tag in its file said it decodes the track's codec.
//! Every module has them (sdk/libs/videocodec/vcodec.zig); the base is
//! the module's, opened with OpenLibrary("codecs/<file>"). One task calls
//! a decoder at a time - the one that decodes the film's pictures.
##include libs/videocodec/videocodec as videocodec
##include libs/videocodec/vcodec as vcodec
##interface
##basetype VCodecBase
##name vcodec
##bias 4
##public
/// What the decoder read from the stream, into `info`: 0, or
/// VCERR_NEED_DATA while it has read nothing to say it from. The size is
/// the pictures' as they are shown, cropped; the rate 0 / 0 when the
/// stream does not say it. A task will do; it does not wait.
i32 GetVCodecInfo(*vcodec.VCodecDecoder decoder, *vcodec.VCodecInfo info)
/// A decoder for a track, or null and why in `err`: VCERR_NOCODEC when
/// this module cannot decode it here - the board has not its chip, or the
/// codec is not one of its own - VCERR_BUSY when its chip runs no more,
/// VCERR_UNSUPPORTED, VCERR_CORRUPT for a setup it cannot read,
/// VCERR_NOMEMORY. `params` and what it points at are the caller's for
/// the call alone. On a process: a chip's decoder may load its firmware.
?*vcodec.VCodecDecoder OpenVCodec(*const vcodec.VCodecParams params, ?*i32 err)
/// The decoder closed, its memory freed - and the frames it still has
/// lent, which may not be shown after.
void CloseVCodec(?*vcodec.VCodecDecoder decoder)
/// A packet of the track in, or its end (VCPKT_END): 0, or VCERR_FULL
/// when it has no room for it yet - a frame is to be taken
/// (ReceiveVCodecFrame) and the packet sent again - or VCERR_NOMEMORY,
/// VCERR_CORRUPT. The bytes are the caller's for the call alone: the
/// decoder copies what it keeps. A packet marked VCPKT_DROP is due before
/// what is shown, and may be decoded only as far as later pictures need
/// it.
i32 SendVCodecPacket(*vcodec.VCodecDecoder decoder, *const vcodec.VCodecPacket packet)
/// The next frame in the order frames are shown, into `frame`: 0;
/// VCERR_NEED_DATA when the decoder wants a packet first; VCERR_END after
/// the last frame, once the end was sent; VCERR_UNSUPPORTED for a stream
/// it turns out it cannot decode - before its first frame, the next
/// module is given the track; VCERR_CORRUPT for a picture it stopped on,
/// which it is called again after; VCERR_BUSY with `held` frames lent;
/// VCERR_NOMEMORY. The frame's planes are the decoder's, lent until
/// ReleaseVCodecFrame, its `time` the packet's that made it, its
/// `private` the decoder's.
i32 ReceiveVCodecFrame(*vcodec.VCodecDecoder decoder, *videocodec.VideoFrame frame)
/// A frame the decoder lent given back, as ReceiveVCodecFrame filled it
/// in; frames come back in any order.
void ReleaseVCodecFrame(*vcodec.VCodecDecoder decoder, *videocodec.VideoFrame frame)
/// Everything sent and not yet handed out forgotten, for a seek: the
/// next packet is a key packet, and the frames lent stay lent.
void FlushVCodec(*vcodec.VCodecDecoder decoder)
##end
