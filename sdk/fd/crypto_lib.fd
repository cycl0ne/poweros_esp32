//! crypto.library's functions: random bytes, hashes, HMAC, HKDF, AES and
//! modular exponentiation on the chip's own engines; key agreement and
//! signatures on X25519, Ed25519, P-256 and P-384, and RSA signatures.
//! A hash, an HMAC or a cipher under way is a context the caller keeps
//! (sdk.crypto); a call that can fail answers 0 or a CRYPTOERR_* code.
##include libs/crypto/crypto as crypto
##basetype CryptoBase
##name crypto.library
##bias 4
##public
/// `length` random bytes into `buffer`, from the chip's generator.
void RandomBytes(*anyopaque buffer, u32 length)
/// `context` set up for a hash of `algorithm` (HASH_*).
i32 InitHash(*crypto.HashContext context, u32 algorithm)
/// `length` more bytes of `data` into the hash.
void UpdateHash(*crypto.HashContext context, ?*const anyopaque data, u32 length)
/// The digest into `digest`: its length in bytes.
u32 FinishHash(*crypto.HashContext context, *anyopaque digest)
/// `context` set up for an HMAC with `algorithm` (HASH_*) and `key`.
i32 InitHmac(*crypto.HmacContext context, u32 algorithm, ?*const anyopaque key, u32 key_length)
/// `length` more bytes of `data` into the HMAC.
void UpdateHmac(*crypto.HmacContext context, ?*const anyopaque data, u32 length)
/// The MAC into `mac`: its length in bytes.
u32 FinishHmac(*crypto.HmacContext context, *anyopaque mac)
/// `context` set up for AES in `mode` (CIPHER_*, CIPHERF_DECRYPT) with
/// `key` and, for CBC and CTR, `iv`.
i32 InitCipher(*crypto.CipherContext context, u32 mode, *const anyopaque key, u32 key_length, ?*const anyopaque iv)
/// `length` bytes of `input` through the cipher into `output`.
i32 UpdateCipher(*crypto.CipherContext context, ?*const anyopaque input, ?*anyopaque output, u32 length)
/// A message encrypted with AES-GCM, and its tag.
i32 SealGcm(*const crypto.GcmMessage message)
/// A message's tag checked with AES-GCM, and the message decrypted.
i32 OpenGcm(*const crypto.GcmMessage message)
/// `base_value` to the power of `exponent`, modulo `modulus`, into
/// `result`: as many bytes as the modulus has.
i32 ModExp(*anyopaque result, *const crypto.Number base_value, *const crypto.Number exponent, *const crypto.Number modulus)
/// HKDF-Extract (RFC 5869) with `algorithm` (HASH_*): a pseudorandom key
/// from `salt` and the input keying material, into `prk` - as many bytes
/// as the digest.
i32 HkdfExtract(u32 algorithm, *const crypto.Bytes salt, *const crypto.Bytes material, *anyopaque prk)
/// HKDF-Expand: `length` bytes of keying material from `prk` and `info`.
i32 HkdfExpand(u32 algorithm, *const crypto.Bytes prk, *const crypto.Bytes info, *anyopaque output, u32 length)
/// A key pair on `curve` (CURVE_*): a random private key and its public
/// key, whose length goes where `public_length` points.
i32 MakeKeyPair(u32 curve, *anyopaque private_key, *anyopaque public_key, *u32 public_length)
/// The secret `private_key` shares with the owner of the public key
/// `peer`, on `curve`.
i32 SharedSecret(u32 curve, *const anyopaque private_key, *const crypto.Bytes peer, *anyopaque secret)
/// Whether `signature` is `key`'s over `digest`, with `algorithm`
/// (SIG_*): CRYPTOERR_OK or CRYPTOERR_SIGNATURE.
i32 VerifySignature(u32 algorithm, *const crypto.PublicKey key, *const crypto.Bytes digest, *const crypto.Bytes signature)
/// `message` signed with `private_key`, with `algorithm` (SIG_ED25519):
/// the signature into `signature`.
i32 Sign(u32 algorithm, *const anyopaque private_key, *const crypto.Bytes message, *anyopaque signature)
##end
