expander.resource/Backlight                        expander.resource/Backlight

   NAME
	Backlight -- What SetBacklight was last given.

   SYNOPSIS
	    u32 Backlight()
expander.resource/ClaimPin                          expander.resource/ClaimPin

   NAME
	ClaimPin -- Take `pin` (0 to PIN_COUNT-1) for `name`, which is kept for the listing and must outlive the claim.

   SYNOPSIS
	    bool ClaimPin(u32 pin, [*:0]const u8 name)

   BEHAVIOR
	False if the pin is out of range or someone else already holds it. A
	driver claims the pins it is going to drive so that two of them fighting
	over one is an error at claim time rather than a light that goes out
	when an unrelated card is initialised.
expander.resource/GetPin                              expander.resource/GetPin

   NAME
	GetPin -- What `pin` reads: 0 or 1, or -1 if the pin is out of range or the part does not answer.

   SYNOPSIS
	    i32 GetPin(u32 pin)
expander.resource/PinOwner                          expander.resource/PinOwner

   NAME
	PinOwner -- Who holds `pin`, or null if nobody does.

   SYNOPSIS
	    ?[*:0]const u8 PinOwner(u32 pin)
expander.resource/ReadADC                            expander.resource/ReadADC

   NAME
	ReadADC -- The analogue input, 0 to 65535, or -1 if the part does not answer.

   SYNOPSIS
	    i32 ReadADC()
expander.resource/ReleasePin                      expander.resource/ReleasePin

   NAME
	ReleasePin -- Give `pin` back.

   SYNOPSIS
	    void ReleasePin(u32 pin)

   BEHAVIOR
	Its level is left as it is.
expander.resource/SetBacklight                  expander.resource/SetBacklight

   NAME
	SetBacklight -- The backlight, BACKLIGHT_OFF (0) to BACKLIGHT_FULL (100).

   SYNOPSIS
	    bool SetBacklight(u32 percent)

   BEHAVIOR
	The register behind it counts the other way, which this hides. False if
	the part does not answer.
expander.resource/SetPin                              expander.resource/SetPin

   NAME
	SetPin -- Drive `pin` high or low.

   SYNOPSIS
	    bool SetPin(u32 pin, bool high)

   BEHAVIOR
	The pin becomes an output if it was not one, its value being written
	before the direction changes so that it never drives the wrong level
	first. False if the pin is out of range or the part does not answer.
