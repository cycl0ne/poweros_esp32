timer.device/AddTime                                      timer.device/AddTime

   NAME
	AddTime -- dest += src, the microseconds carried into the seconds.

   SYNOPSIS
	    void AddTime(*timer.TimeVal dest, *const timer.TimeVal src)
timer.device/CmpTime                                      timer.device/CmpTime

   NAME
	CmpTime -- 0 if they are equal, -1 if dest is later than src, +1 if it is earlier.

   SYNOPSIS
	    i32 CmpTime(*const timer.TimeVal dest, *const timer.TimeVal src)
timer.device/GetSysTime                                timer.device/GetSysTime

   NAME
	GetSysTime -- The system time into dest.

   SYNOPSIS
	    void GetSysTime(*timer.TimeVal dest)

   BEHAVIOR
	It only ever rises and never repeats.
timer.device/ReadEClock                                timer.device/ReadEClock

   NAME
	ReadEClock -- The E-clock count now into dest; returns the E-clock's rate in Hz.

   SYNOPSIS
	    u32 ReadEClock(*timer.EClockVal dest)
timer.device/SubTime                                      timer.device/SubTime

   NAME
	SubTime -- dest -= src, borrowing a second when needed.

   SYNOPSIS
	    void SubTime(*timer.TimeVal dest, *const timer.TimeVal src)
